+def _sanitize_contact_address_text(value: Optional[str]) -> str:
+    text = str(value or "").strip()
+    if not text:
+        return ""
+    text = text.replace("-", " ")
+    text = re.sub(r"(?:â€œ|â€|â€ž|â€˜|â€™|“|”|„|‚|’|‘)+", "", text)
+    text = re.sub(r"[\"“”'`]+", "", text)
+    text = text.strip(" .,)];:")
+    text = re.sub(r"[^\w\s]+$", "", text, flags=re.UNICODE)
+    text = re.sub(r"\s+", " ", text)
+    return text.strip()
