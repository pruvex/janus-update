+def _split_contact_preference_values(value: Optional[str]) -> List[str]:
+    text = str(value or "").strip(" .")
+    if not text:
+        return []
+    if " und " not in text.casefold():
+        return [text]
+    parts = [part.strip(" .") for part in re.split(r"\s+und\s+", text, flags=re.IGNORECASE)]
+    if len(parts) < 2:
