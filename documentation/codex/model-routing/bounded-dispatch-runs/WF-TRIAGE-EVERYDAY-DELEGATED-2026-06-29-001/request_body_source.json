      "content": "{\n  \"task_class\": \"test_result_triage_review\",\n  \"workflow_id\": \"WF-TRIAGE-EVERYDAY-PACKAGE-001\",\n  \"bound_skill_context\": \"janus-test-pipeline\",\n  \"test_run_id\": \"TEST-RUN-TRIAGE-EVERYDAY-001\",\n  \"result_outcome_summary\": \"One bounded local result bundle needs assist-only classification review.\",\n  \"evidence_snippets\": [\n    \"Result bundle already redacted.\",\n    \"One bounded classification question only.\",\n    \"Codex keeps rerun and routing ownership.\"\n  ],\n  \"classification_question\": \"Is this more likely an INFRA_BLOCKER or TEST_BUG?\",\n  \"constraints\": [\n    \"At most 2 finding clusters\",\n    \"No live test execution\",\n    \"No final PASS decision\",\n    \"redaction_check must be PASS\"\n  ]\n}"
