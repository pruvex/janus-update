{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/openrouter/benchmark_result.schema.json",
  "title": "OpenRouter Delegation Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "corpus_version",
    "models",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["janus.openrouter.benchmark_result.v1"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_status": {
      "type": "string",
      "enum": ["complete", "partial", "blocked", "failed"]
    },
    "completed_cases": {
      "type": "integer",
      "minimum": 0
    },
    "expected_cases": {
      "type": "integer",
      "minimum": 0
    },
    "missing_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_type": {
      "type": "string",
      "enum": ["none", "local_exception", "request_timeout", "provider_or_transport_error", "unknown"]
    },
    "failure_message": {
      "type": ["string", "null"],
      "maxLength": 600
    },
    "corpus_version": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "model_id",
          "schema_valid",
          "mode_correct",
          "risk_flags_complete",
          "forbidden_flags_absent",
          "production_safe",
          "failure_type",
          "expected_mode",
          "actual_mode",
          "score",
          "errors",
          "elapsed_ms"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "schema_valid": {
            "type": "boolean"
          },
          "mode_correct": {
            "type": "boolean"
          },
          "risk_flags_complete": {
            "type": "boolean"
          },
          "forbidden_flags_absent": {
            "type": "boolean"
          },
          "production_safe": {
            "type": "boolean"
          },
          "failure_type": {
            "type": "string",
            "enum": ["model_output", "local_policy_deny", "request_timeout", "provider_or_transport_error"]
          },
          "expected_mode": {
            "type": "string",
            "enum": ["ALLOW", "ASSIST", "DENY", "UNKNOWN"]
          },
          "actual_mode": {
            "type": ["string", "null"],
            "enum": ["ALLOW", "ASSIST", "DENY", "UNKNOWN", null]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elapsed_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "response_debug": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "model_id",
              "http_status",
              "top_level_payload_keys",
              "choice_keys",
              "message_keys",
              "finish_reason",
              "message_content_type",
              "message_content_shape",
              "has_reasoning",
              "has_refusal",
              "has_tool_calls",
              "has_parsed"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "model_id": {
                "type": "string"
              },
              "http_status": {
                "type": ["integer", "null"]
              },
              "top_level_payload_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "choice_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "finish_reason": {
                "type": ["string", "null"]
              },
              "message_content_type": {
                "type": "string"
              },
              "message_content_shape": {
                "type": "string",
                "enum": ["null", "empty", "string", "object", "list", "int", "float", "bool"]
              },
              "has_reasoning": {
                "type": "boolean"
              },
              "has_refusal": {
                "type": "boolean"
              },
              "has_tool_calls": {
                "type": "boolean"
              },
              "has_parsed": {
                "type": "boolean"
              },
              "error_code": {
                "type": ["string", "null"]
              },
              "error_provider_name": {
                "type": ["string", "null"]
              },
              "error_message": {
                "type": ["string", "null"],
                "maxLength": 180
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_approved", "notes"],
      "properties": {
        "production_approved": {
          "type": "boolean",
          "enum": [false]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
