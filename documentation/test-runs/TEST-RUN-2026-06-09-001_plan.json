      "id": "TC-001-GPT",
      "name": "New contact creation from direct utterance",
      "type": "functional",
      "provider": "GPT",
      "model": "gpt-5.4-nano",
      "prompt": "`mein freund oli (oliver schwab) wohnt in köln stammheim`",
      "expected": {
        "containsAny": [
          "Quelle:",
          "Wetterdienst",
          "Open-Meteo",
          "Wetterdaten laut",
          "Wetterdaten nach"
        ],
        "mustNotContain": [
          "Bankueberweisung",
          "unbegrenzt"
        ]
      },
      "parallelSafe": false,
      "isolationKey": "GPT:serial",
      "testDataNamespace": "serial-TC-001-GPT",
